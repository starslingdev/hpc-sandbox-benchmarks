#!/usr/bin/env bash
#MISE description="Identify a sandbox end to end: egress ASN/geo, hardware identity, the exact isolation technique (Firecracker/libkrun/Cloud Hypervisor/gVisor/Sysbox/Kata/LXC/…), and Docker-in-Docker readiness"
# Mirrors the "Provider Info" step of runs-on Bench Global, which is the source of the
# `Infrastructure` column in their published table:
#
#     IPINFO=$(curl -s ipinfo.io); ORG=$(jq -r '.org') ; # => "AS31898 Oracle Corporation"
#     MANUFACTURER=$(sudo dmidecode -s system-manufacturer)
#
# WHAT `.org` ACTUALLY IS: the ASN that announces the sandbox's *public egress IP*. It is a network
# fact, not a hardware one. A sandbox NATs its egress through the provider's own network, so this
# names whoever owns the address block the traffic leaves from — which may be the underlying host
# cloud (Oracle, AWS) rather than the vendor you buy from (Daytona, Novita), or a transit/proxy
# network belonging to neither.
#
# So we record the DMI identity alongside it. `system-manufacturer` / `product-name` come from the
# hypervisor's SMBIOS tables and describe the machine the kernel is running on. When the two
# disagree, the DMI is the better answer to "whose metal is this" and the ASN answers "whose network
# is this". Both are reported; neither is silently preferred.
#
# WHY NOT ipinfo.io FOR THE ASN. Anonymous ipinfo is quota'd per source IP, and a matrix fan-out
# behind one NAT egress makes many anonymous calls. On a 429 it returns a JSON error body, `.org`
# resolves to empty, and the provider column silently reads "unknown" — indistinguishable from a
# sandbox we genuinely could not identify. So the ASN comes from Team Cymru's DNS whois instead:
# authoritative BGP origin data, no HTTP, no quota, no install, and no key. ipinfo is retained only
# for city/region, and its failure is recorded in `geo_source` rather than blanking the identity.
#
# AND THE THIRD QUESTION — "what is actually isolating this workload". Neither the ASN nor the DMI
# answers it, and it is the one that decides whether two providers' numbers may be read side by
# side: a gVisor syscall trap, a Firecracker virtio round-trip and a Sysbox namespace boundary have
# different overhead profiles for the same benchmark. The schema DECLARES an isolation per provider
# (packages/schema/src/providers.ts), authoritative but unverified; the isolation section below is
# the independent observation. See its own header for the method.
#
# Tolerant probe: no -e — report whatever the sandbox exposes (error-mode conventions: lib/bench.sh).
# Passive: it reads /proc, /sys and /dev and asks already-running daemons for their version. It never
# starts a daemon, mounts anything, loads a module, or launches a container.
set -uo pipefail
REPO_ROOT="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
source "${REPO_ROOT}/lib/bench.sh"

RESULT_FILE="$(result_path "$(task_result_name)")"
SCHEMA_VERSION="2.0"

have() { command -v "$1" >/dev/null 2>&1; }
# First line of a pseudo-file, NUL-stripped and whitespace-collapsed, or empty when unreadable.
# (/proc/self/attr/current is NUL-terminated and /sys/class/dmi/* values can carry trailing blanks.)
readline() {
	[ -r "$1" ] || return 0
	tr -d '\000' <"$1" 2>/dev/null | head -1 | tr -s '[:space:]' ' ' | sed 's/^ //; s/ $//'
}
rstrip() {
	local s="$1"
	printf '%s' "${s%"${s##*[![:space:]]}"}"
}
# Comma-join the unique lines on stdin. The compact, order-stable form every set-valued signal below
# is recorded in, so two sandboxes with the same shape produce the same string.
joinset() { LC_ALL=C sort -u | tr '\n' ',' | sed 's/,$//'; }

# --- Public egress IP --------------------------------------------------------
# DNS echoes first: no quota, and they answer over :53 where an HTTP egress proxy may not exist.
# Each is capped so a blackholed resolver cannot stall the leg. HTTP echoes are the fallback.
# Keep only the first line that IS an address of the leg's family. Validation must happen PER LEG:
# dig prints multi-record answers (edns-client-subnet lines) and even failure diagnostics (";;
# communications error …") to stdout under +short, and a proxy can serve HTML to curl — any
# non-empty garbage accepted here would short-circuit the remaining legs and yield no IP on a
# working network.
_first_ipv4() { tr -d '"' | grep -m1 -xE '[0-9]{1,3}(\.[0-9]{1,3}){3}' || true; }
# A public egress address must be global unicast — 2000::/3, i.e. a leading hextet of four hex digits
# starting with 2 or 3. Rejects the forms an echo leg can plausibly hand back that are NOT an egress
# address: `::` (unspecified), `::1` (a proxy answering on loopback), fe80::/10 link-local, fc00::/7
# ULA, ff00::/8 multicast, and ::ffff:0:0/96 v4-mapped. Deliberately tests only the leading hextet so
# it needs no expansion and can run during discovery — _v6_nibbles is defined further down, after
# PUBLIC_IP is already resolved, so it is not callable from here.
_is_global_v6() { [[ "${1%%:*}" =~ ^[23][0-9a-fA-F]{3}$ ]]; }
# Permissive line-picker (accepts some malformed colon runs) followed by the global-unicast filter.
# The filter is what keeps a bad leg from ending discovery: a non-global echo must fall through to the
# remaining legs rather than pin the whole identity to an address with no public egress. Scanning all
# candidate lines (no -m1) means a diagnostic line preceding the real answer can't mask it either.
# cymru_lookup's nibble expansion remains the strict structural validator before anything is queried.
_first_ipv6() {
	local line
	tr -d '"' | grep -xiE '([0-9a-f]{0,4}:){2,7}[0-9a-f]{0,4}' | while IFS= read -r line; do
		_is_global_v6 "$line" && { printf '%s' "$line"; break; }
	done
}
public_ip() {
	# One family per probe run: every identity field (ASN, prefix, geo) must describe the SAME
	# address. IPv4 legs run first; the IPv6 legs are a whole-identity fallback for sandboxes with no
	# public IPv4 path at all (e.g. Blaxel egresses through a globally-routed IPv6) — the Cymru and
	# ipinfo lookups below follow whichever family answered here.
	local ip=""
	if have dig; then
		ip="$(dig -4 @ns1.google.com TXT o-o.myaddr.l.google.com +short +time=2 +tries=1 2>/dev/null | _first_ipv4)"
		[ -z "$ip" ] && ip="$(dig -4 @resolver1.opendns.com myip.opendns.com +short +time=2 +tries=1 2>/dev/null | _first_ipv4)"
		[ -z "$ip" ] && ip="$(dig -4 @1.0.0.1 ch txt whoami.cloudflare +short +time=2 +tries=1 2>/dev/null | _first_ipv4)"
	fi
	[ -z "$ip" ] && ip="$(curl -s -4 --max-time 3 https://ifconfig.me 2>/dev/null | _first_ipv4)"
	[ -z "$ip" ] && ip="$(curl -s -4 --max-time 3 https://ipinfo.io/ip 2>/dev/null | _first_ipv4)"
	if [ -z "$ip" ]; then
		if have dig; then
			# Both echoes report the QUERY's source address, so over -6 transport they return the
			# public IPv6. (No OpenDNS leg: myip.opendns.com only answers for A-record resolvers.)
			ip="$(dig -6 @ns1.google.com TXT o-o.myaddr.l.google.com +short +time=2 +tries=1 2>/dev/null | _first_ipv6)"
			[ -z "$ip" ] && ip="$(dig -6 @2606:4700:4700::1111 ch txt whoami.cloudflare +short +time=2 +tries=1 2>/dev/null | _first_ipv6)"
		fi
		[ -z "$ip" ] && ip="$(curl -s -6 --max-time 3 https://ifconfig.me 2>/dev/null | _first_ipv6)"
		[ -z "$ip" ] && ip="$(curl -s -6 --max-time 3 https://ipinfo.io/ip 2>/dev/null | _first_ipv6)"
	fi
	printf '%s' "$ip"
}
PUBLIC_IP="$(public_ip)"

# --- ASN + org, from Team Cymru DNS whois ------------------------------------
# <reversed-ip>.origin.asn.cymru.com  TXT => "31898 | 161.153.0.0/17 | US | arin | 2024-07-01"
# <reversed-nibbles>.origin6.asn.cymru.com  (same shape, for an IPv6 egress)
# AS<n>.asn.cymru.com          TXT      => "31898 | US | arin | ... | ORACLE-BMC-31898 - Oracle Corporation, US"
ASN=""
ORG_NAME=""
PREFIX=""
ASN_SOURCE="unavailable"
# Print the origin6 QNAME labels for an IPv6 literal — its 32 nibbles, reversed, dot-separated —
# or fail on anything that is not a plain global IPv6 address (zone suffixes, v4-mapped forms,
# malformed groups). This is the strict validator behind _first_ipv6's permissive line-picker.
_v6_nibbles() {
	local ip="$1" left="" right="" hex="" group i
	local -a lparts=() rparts=() groups=()
	[[ "$ip" == *:* ]] || return 1
	# Enforce the "global" half of this function's contract; the structural checks below enforce the
	# "plain IPv6 address" half. Without it `::`, `::1` and fe80::/10 all expand happily, and a
	# caller reaching here by some path other than _first_ipv6 would query Cymru for a non-egress
	# address.
	_is_global_v6 "$ip" || return 1
	if [[ "$ip" == *"::"* ]]; then
		left="${ip%%::*}"
		right="${ip#*::}"
	else
		left="$ip"
	fi
	[ -n "$left" ] && IFS=: read -ra lparts <<<"$left"
	[ -n "$right" ] && IFS=: read -ra rparts <<<"$right"
	local fill=$((8 - ${#lparts[@]} - ${#rparts[@]}))
	# "::" must stand for at least one zero group, and a full address must have exactly eight.
	if [[ "$ip" == *"::"* ]]; then [ "$fill" -ge 1 ] || return 1; else [ "$fill" -eq 0 ] || return 1; fi
	groups=("${lparts[@]}")
	for ((i = 0; i < fill; i++)); do groups+=("0"); done
	groups+=("${rparts[@]}")
	for group in "${groups[@]}"; do
		[[ "$group" =~ ^[0-9a-fA-F]{1,4}$ ]] || return 1
		hex+="$(printf '%04x' "0x$group")"
	done
	local out=""
	for ((i = ${#hex} - 1; i >= 0; i--)); do out+="${hex:i:1}."; done
	printf '%s' "${out%.}"
}
# Shared tail of both families' lookups: parse the origin TXT, then resolve the AS name.
_cymru_from_origin() {
	local qname="$1" origin asn name
	origin="$(dig +short +time=2 +tries=1 "$qname" TXT 2>/dev/null | tr -d '"' | head -1)"
	# Require the answer's documented shape ("31898 | 161.153.0.0/17 | …"): dig prints resolver
	# failure diagnostics (";; communications error …") to STDOUT even under +short, and treating one
	# as an answer would record asn="AS;;" with asn_source=cymru while blocking the ipinfo fallback.
	[[ "$origin" =~ ^[0-9]+[0-9\ ]*\| ]] || return 1
	# Field 1 lists SEVERAL space-separated origin ASNs for a MOAS prefix ("23028 23029 | …"); take
	# the first — stripping the spaces instead would fabricate a nonexistent AS number.
	asn="$(printf '%s' "$origin" | awk -F'|' '{split($1, parts, " "); print parts[1]}')"
	[[ "$asn" =~ ^[0-9]+$ ]] || return 1
	PREFIX="$(printf '%s' "$origin" | awk -F'|' '{gsub(/^ +| +$/,"",$2); print $2}')"
	# Field 5 of the AS record is "HANDLE - Org Name, CC"; take the org half.
	name="$(dig +short +time=2 +tries=1 "AS${asn}.asn.cymru.com" TXT 2>/dev/null | tr -d '"' |
		awk -F'|' '{gsub(/^ +| +$/,"",$5); print $5}' | head -1)"
	name="$(printf '%s' "$name" | sed -E 's/^[A-Z0-9_-]+ - //; s/, [A-Z]{2}$//')"
	ASN="AS${asn}"
	ORG_NAME="$name"
	ASN_SOURCE="cymru"
}
cymru_lookup() {
	local ip="$1" rev nib
	have dig || return 1
	# Dispatch by family — the IPv6 nibble form is a different zone (origin6). Bail on anything
	# that is neither, rather than silently querying a malformed name.
	if [[ "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
		rev="$(printf '%s' "$ip" | awk -F. '{print $4"."$3"."$2"."$1}')"
		_cymru_from_origin "${rev}.origin.asn.cymru.com"
	else
		nib="$(_v6_nibbles "$ip")" || return 1
		_cymru_from_origin "${nib}.origin6.asn.cymru.com"
	fi
}
[ -n "$PUBLIC_IP" ] && { cymru_lookup "$PUBLIC_IP" || true; }

# --- Geo, best-effort, from ipinfo -------------------------------------------
# 3s cap: an unreachable metadata service must not stall a benchmark leg.
# Same family as the echoed egress address: the Cymru lookup and this geo record must describe the
# SAME address, or a dual-stack sandbox reports an ASN for one address and a city for another.
CURL_FAMILY="-4"
[[ "$PUBLIC_IP" == *:* ]] && CURL_FAMILY="-6"
IPINFO="$(curl -s "$CURL_FAMILY" --max-time 3 https://ipinfo.io 2>/dev/null || echo '{}')"
jq_get() { printf '%s' "$IPINFO" | jq -r "$1 // \"\"" 2>/dev/null || printf ''; }

# A quota'd or errored ipinfo returns a body with `.error` (or no `.ip` at all). Distinguish that
# from a genuine answer instead of silently reporting blanks.
GEO_SOURCE="ipinfo"
if ! have jq; then
	# "No parser on this image" is NOT "ipinfo refused us": jq_get's `|| printf ''` swallows exit 127,
	# so without this every field reads empty under a geo_source claiming an upstream outage.
	GEO_SOURCE="no-jq"
	IPINFO='{}'
elif [ -n "$(jq_get .error.title)" ] || [ -z "$(jq_get .ip)" ]; then
	# When no echo pinned a family the first fetch tried IPv4; retry IPv6 once before declaring geo
	# unavailable — a v6-only sandbox reaches ipinfo only that way, and with PUBLIC_IP empty there is
	# no other address for these fields to disagree with. A pinned family is never second-guessed.
	if [ -z "$PUBLIC_IP" ]; then
		IPINFO="$(curl -s -6 --max-time 3 https://ipinfo.io 2>/dev/null || echo '{}')"
	fi
	if [ -n "$(jq_get .error.title)" ] || [ -z "$(jq_get .ip)" ]; then
		GEO_SOURCE="unavailable"
		IPINFO='{}'
	fi
fi

CITY="$(jq_get .city)"
REGION="$(jq_get .region)"
COUNTRY="$(jq_get .country)"
LOC="$(jq_get .loc)" # "lat,lon"
TIMEZONE="$(jq_get .timezone)"
HOSTNAME_PTR="$(jq_get .hostname)"
[ -z "$PUBLIC_IP" ] && PUBLIC_IP="$(jq_get .ip)"
# The echo legs can fail while Cymru's DNS still works (an HTTP-only egress proxy). Retry the
# BGP-origin lookup with the address ipinfo just recovered, rather than settling for its `.org` —
# which is quota'd per source IP and loses Cymru's MOAS-first ordering.
[ -z "$ASN" ] && [ -n "$PUBLIC_IP" ] && { cymru_lookup "$PUBLIC_IP" || true; }

# Fall back to ipinfo's org string only if Cymru could not answer, splitting
# "AS31898 Oracle Corporation" into its halves. An org string without a leading ASN leaves asn empty
# rather than swallowing the first word.
if [ -z "$ASN" ]; then
	IPINFO_ORG="$(jq_get .org)"
	if [[ "$IPINFO_ORG" =~ ^(AS[0-9]+)[[:space:]]+(.*)$ ]]; then
		ASN="${BASH_REMATCH[1]}"
		ORG_NAME="${BASH_REMATCH[2]}"
		ASN_SOURCE="ipinfo"
	elif [ -n "$IPINFO_ORG" ]; then
		ORG_NAME="$IPINFO_ORG"
		ASN_SOURCE="ipinfo"
	fi
fi

# runs-on's `Infrastructure` column is this literal string; keep the shape so our table and theirs
# can be read side by side. No trailing space when the AS-name lookup came back empty — exact-match
# grouping on this field must not split "AS31898" from "AS31898 ".
if [ -n "$ASN" ] && [ -n "$ORG_NAME" ]; then
	ORG="$ASN $ORG_NAME"
else
	ORG="${ASN}${ORG_NAME}"
fi

# --- Hardware identity (SMBIOS/DMI) ------------------------------------------
# Ten fields, not three: a VMM that fills none of sys_vendor/product_name still often fills
# board_name or bios_version (Proxmox writes its version into the BIOS string; Apple's
# Virtualization.framework only identifies itself in product_name), and a cloud's instance TYPE lives
# in product_name or product_sku. Collected into one lowercased haystack for matching, and kept
# individually for the record.
dmi() {
	# /sys is readable without dmidecode or root; fall back to dmidecode (sandboxes run as root).
	local sysfile="/sys/class/dmi/id/$1" key="$2"
	if [ -r "$sysfile" ]; then
		tr -d '\n' <"$sysfile"
	else
		dmidecode -s "$key" 2>/dev/null | grep -v '^#' | head -1 | tr -d '\n'
	fi
}
MANUFACTURER="$(dmi sys_vendor system-manufacturer)"
PRODUCT_NAME="$(dmi product_name system-product-name)"
PRODUCT_VERSION="$(dmi product_version system-product-version)"
PRODUCT_FAMILY="$(dmi product_family system-product-family)"
BOARD_VENDOR="$(dmi board_vendor baseboard-manufacturer)"
BOARD_NAME="$(dmi board_name baseboard-product-name)"
BIOS_VENDOR="$(dmi bios_vendor bios-vendor)"
BIOS_VERSION="$(dmi bios_version bios-version)"
CHASSIS_VENDOR="$(dmi chassis_vendor chassis-manufacturer)"
DMI_ALL="${MANUFACTURER} ${PRODUCT_NAME} ${PRODUCT_VERSION} ${PRODUCT_FAMILY} ${BOARD_VENDOR} ${BOARD_NAME} ${BIOS_VENDOR} ${BIOS_VERSION} ${CHASSIS_VENDOR}"
DMI_LC="${DMI_ALL,,}"

# Which hypervisor, if any. NOT via get(): systemd-detect-virt prints "none" AND exits 1 on bare
# metal, and get()'s discard-on-nonzero would turn confirmed bare metal into an empty field —
# indistinguishable from "tool missing" on exactly the whose-metal-is-this axis this probe answers.
VIRT="$(systemd-detect-virt 2>/dev/null || true)"
# The two narrowed forms. `--vm` restricts detection to VM technologies and `--container` to
# container technologies, so a sandbox that is BOTH reports both instead of only whichever the
# unqualified call happens to rank first — which is how a KVM guest inside a container namespace
# ends up reported as a plain container.
VIRT_VM=""
VIRT_CONTAINER=""
if have systemd-detect-virt; then
	VIRT_VM="$(systemd-detect-virt --vm 2>/dev/null || true)"
	VIRT_CONTAINER="$(systemd-detect-virt --container 2>/dev/null || true)"
fi
# virt-what is the other established detector and disagrees usefully: it reads CPUID leaves and DMI
# directly rather than consulting marker files first, so it does not inherit systemd's
# image-residue failure mode. Rarely installed; treated as a bonus, never a requirement.
VIRT_WHAT=""
have virt-what && VIRT_WHAT="$(virt-what 2>/dev/null | joinset)"

# =============================================================================
# Isolation fingerprint — WHICH sandboxing technique is this?
# =============================================================================
# `virtualization` above (systemd-detect-virt) answers a strictly coarser question than the one this
# comparison needs. Every KVM-backed microVM reads exactly `kvm` — Firecracker, libkrun, Cloud
# Hypervisor, crosvm and stock QEMU are one indistinguishable bucket — while gVisor reads
# `container-other` and a stock OCI container reads `docker`. Worse, it consults marker FILES before
# it looks at hardware, so an image built from a Docker base that baked in `/run/systemd/container`
# makes a genuine microVM report `docker` (observed on this repo's own dev sandbox: a Firecracker
# guest, ACPI OEM id `FIRECK`, that systemd-detect-virt calls a container).
#
# METHOD — evidence, then score, then rank.
#   1. Collect independently meaningful SIGNALS and publish every one of them.
#   2. Score CANDIDATES with weighted, individually-attributed reasons. Weight is the class of the
#      evidence, not a guess at a probability:
#        100  the runtime NAMES ITSELF (ACPI OEM id, SMBIOS vendor, a gVisor banner, a sysboxfs
#             mount, an LXD socket). A self-declaration, not an inference.
#         60  a signature no other deployed implementation produces.
#         30  a signature consistent with this implementation and a few others.
#         15  compatible-with, i.e. it does not argue against.
#        <0   evidence that ARGUES AGAINST (a microVM with SMBIOS is not Firecracker).
#      A generic bucket is capped below any specific match, so "some microVM" can never outrank a
#      named one, and ties break toward the more specific candidate.
#   3. Rank, and report the runners-up with their reasons. The verdict is never the only thing kept:
#      a reader who disagrees can re-derive it from the signals in the committed record.
#
# TWO LAYERS, scored separately, because a sandbox is routinely both and a single ranked list would
# have to hide one of them. `machine_vmm` is the virtualization under the kernel we can see;
# `container_runtime` is the namespace/kernel-emulation boundary layered on top (Daytona's container
# class is Sysbox inside a VM; Modal's default is gVisor; Kata is an OCI runtime whose boundary is a
# microVM). `isolation_runtime` is the headline — the innermost boundary, i.e. the one that actually
# confines the workload — and it is a single token so no consumer has to parse a compound label.
#
# WHAT IS DELIBERATELY NOT IN THE JSON. The raw kernel command line, cgroup paths, overlay upperdirs
# and the mountinfo dump identify a single sandbox (container ids) or can carry a control-plane token
# or internal endpoint. Every JSON field here lands in a committed dataset that folds host records by
# identity, so a per-sandbox string in one field would both leak and defeat the fold (see
# packages/results/src/lib/host-metadata.ts). They are printed in the human evidence table below,
# where they are useful for debugging a run, and only matched TOKENS and derived ENGINE names reach
# the record — which is all a re-classification needs.

# Human-readable evidence table: "key<TAB>value<TAB>source<TAB>strength". Report-only, by the rule
# above. Values are collapsed to one line so the table stays a table.
EVIDENCE_ROWS=()
evidence() {
	local value
	# Trimmed, not merely collapsed: several haystacks here are built by joining fields that are all
	# empty ("$MANUFACTURER $PRODUCT_NAME …"), which leaves a run of spaces that is not an
	# observation and must not print as one.
	value="$(printf '%s' "${2:-}" | tr -d '\000' | tr '\n\t' '  ' | tr -s ' ' | sed 's/^ //; s/ $//')"
	[ -n "$value" ] || return 0
	EVIDENCE_ROWS+=("$1	${value}	${3:-probe}	${4:-informational}")
	return 0
}

# The boot log, read ONCE and bounded. Everything this section wants from it — the ACPI RSDP line,
# "Hypervisor detected: …", gVisor's startup banner, the memory-encryption line — is printed during
# early boot, and slurping an unbounded ring buffer into a shell variable is not free. Captured into
# a variable rather than grepped through a pipe in a condition, because `set -o pipefail` turns the
# SIGPIPE that `head` delivers to `dmesg` into a non-zero pipeline status: an
# `if dmesg | head | grep -q …` test reports FALSE on a successful match, which is exactly backwards.
DMESG_HEAD=""
have dmesg && DMESG_HEAD="$(dmesg 2>/dev/null | head -400)"

# ---- Signal: kernel command line (matched tokens only) ----------------------
# A VMM's default boot arguments are one of the strongest fingerprints available on a guest with no
# SMBIOS at all: Firecracker boots `reboot=k panic=1 pci=off`, libkrun `console=hvc0
# rootfstype=virtiofs … no-kvmapf`, Kata carries its `agent.*` options, EC2 its
# `nvme_core.io_timeout`.
KERNEL_CMDLINE=""
[ -r /proc/cmdline ] && KERNEL_CMDLINE="$(tr -d '\n' </proc/cmdline 2>/dev/null)"
CMDLINE_TOKENS=(
	reboot=k panic=1 panic=-1 pci=off nomodule no-kvmapf noapic acpi=off
	virtio_mmio.device console=ttyS0 console=hvc0 console=tty0 console=ttyAMA0
	root=/dev/vda root=/dev/pmem0 root=/dev/xvda rootfstype=virtiofs rootfstype=ext4
	init=/init.krun agent. systemd.unit=kata-containers.target
	nvme_core.io_timeout xen_blkfront hv_storvsc
)
CMDLINE_MARKERS=""
for _token in "${CMDLINE_TOKENS[@]}"; do
	# Anchored at a word boundary (the leading space) so `panic=1` cannot match inside `panic=100`
	# and `console=ttyS0` cannot match a substring of some other option's value.
	case " ${KERNEL_CMDLINE} " in
	*" ${_token}"*) CMDLINE_MARKERS="${CMDLINE_MARKERS:+${CMDLINE_MARKERS},}${_token}" ;;
	esac
done
cmdline_has() { case ",${CMDLINE_MARKERS}," in *",${1},"*) return 0 ;; esac; return 1; }

# ---- Signal: ACPI table identity — the SMBIOS substitute --------------------
# The minimal VMMs deliberately ship no SMBIOS, which is why `manufacturer`/`product_name` above are
# empty for almost every provider in this matrix. Most of them DO expose ACPI, and an ACPI table
# header carries the same kind of self-declaration: a 6-byte OEM id, an 8-byte OEM table id and a
# 4-byte creator id. Firecracker writes `FIRECK`/`FCVMDSDT`/`FCAT`, Cloud Hypervisor `CLOUDH`, a
# SeaBIOS-built QEMU guest `BOCHS`/`BXPC`, crosvm `CROSVM`. That makes this the single highest-value
# probe in the section — a definitive VMM name exactly where DMI has nothing to say.
#
# Layout (ACPI 6.x §21.2.1, the fixed 36-byte description header): signature[4] length[4]
# revision[1] checksum[1] oem_id[6] oem_table_id[8] oem_revision[4] creator_id[4]
# creator_revision[4] — so the OEM id is at byte 10, the OEM table id at 16, the creator id at 28.
ACPI_OEM=""
ACPI_OEM_TABLE=""
ACPI_CREATOR=""
_read_acpi_ids() {
	local table oem
	for table in /sys/firmware/acpi/tables/DSDT /sys/firmware/acpi/tables/FACP \
		/sys/firmware/acpi/tables/APIC /sys/firmware/acpi/tables/XSDT; do
		[ -r "$table" ] || continue
		oem="$(dd if="$table" bs=1 skip=10 count=6 2>/dev/null | tr -cd '[:print:]')"
		[ -n "$oem" ] || continue
		ACPI_OEM="$(rstrip "$oem")"
		ACPI_OEM_TABLE="$(rstrip "$(dd if="$table" bs=1 skip=16 count=8 2>/dev/null | tr -cd '[:print:]')")"
		ACPI_CREATOR="$(rstrip "$(dd if="$table" bs=1 skip=28 count=4 2>/dev/null | tr -cd '[:print:]')")"
		return 0
	done
	return 1
}
_read_acpi_ids || true
if [ -z "$ACPI_OEM" ] && [ -n "$DMESG_HEAD" ]; then
	# `/sys/firmware/acpi/tables/*` is mode 0400; a non-root sandbox falls back to the boot log, which
	# prints the same ids: "ACPI: RSDP 0x…E0000 000024 (v02 FIRECK)" and
	# "ACPI: DSDT 0x…9FD6C 001021 (v02 FIRECK FCVMDSDT 00000000 FCAT 20240119)".
	ACPI_OEM="$(rstrip "$(printf '%s\n' "$DMESG_HEAD" | sed -n 's/^.*ACPI: RSDP .*(v[0-9]* \([^)]*\)).*$/\1/p' | head -1)")"
	ACPI_CREATOR="$(printf '%s\n' "$DMESG_HEAD" | sed -n 's/^.*ACPI: DSDT .*(v[0-9]* [A-Za-z0-9_ .-]\{1,6\} [A-Za-z0-9_.-]\{1,8\} [0-9A-Fa-f]\{8\} \([A-Za-z0-9_.-]\{1,4\}\).*$/\1/p' | head -1)"
fi
ACPI_LC="${ACPI_OEM,,} ${ACPI_OEM_TABLE,,} ${ACPI_CREATOR,,}"

# ---- Signal: is there a hypervisor under this kernel at all? ----------------
# The CPUID hypervisor bit is set by every VMM and by nothing else, so it separates "guest" from
# "bare metal" without naming anyone. lscpu's vendor line resolves the paravirt interface (KVM,
# VMware, Microsoft, Xen) when the tool exists; the boot log carries the same string when it does not.
#
# The bit is x86-only. On aarch64 /proc/cpuinfo has a `Features` line and no hypervisor bit at all,
# so its ABSENCE there says nothing — recorded separately as `cpuinfo_flags` rather than folded into
# the flag, because "no hypervisor bit on x86" is proof of bare metal and "no hypervisor bit on ARM"
# is no information whatsoever, and one boolean cannot mean both.
_flags_line="$(grep -m1 '^flags' /proc/cpuinfo 2>/dev/null)"
CPUINFO_FLAGS="false"
[ -n "$_flags_line" ] && CPUINFO_FLAGS="true"
# Whole-word match in the shell rather than a `grep` alternation: BRE `\|` is a GNU extension that a
# busybox image does not honour, and silently never matching would read as bare metal.
HYPERVISOR_FLAG="false"
case " ${_flags_line} " in *" hypervisor "*) HYPERVISOR_FLAG="true" ;; esac
CPU_HYPERVISOR=""
if have lscpu; then
	CPU_HYPERVISOR="$(LC_ALL=C lscpu 2>/dev/null | sed -n 's/^Hypervisor vendor:[[:space:]]*//p' | head -1)"
fi
if [ -z "$CPU_HYPERVISOR" ] && [ -n "$DMESG_HEAD" ]; then
	CPU_HYPERVISOR="$(printf '%s\n' "$DMESG_HEAD" | sed -n 's/^.*Hypervisor detected: //p' | head -1)"
fi
# Paravirt buses that only one hypervisor family ever creates.
HYPERVISOR_NODE="$(readline /sys/hypervisor/type)" # "xen" under Xen
HAS_VMBUS="false"
[ -d /sys/bus/vmbus ] && HAS_VMBUS="true" # Hyper-V's VMBus, incl. Azure
HAS_XEN_NODE="false"
{ [ -d /proc/xen ] || [ "$HYPERVISOR_NODE" = "xen" ]; } && HAS_XEN_NODE="true"

# ---- Signal: confidential computing -----------------------------------------
# A memory-encrypted guest is a materially different isolation boundary (the host cannot read guest
# memory), so it is reported as an attribute of whatever VMM is running rather than as a competing
# candidate. The kernel exposes it three ways and any one is enough.
CC_TECH=""
[ -r /sys/kernel/coco/securityfs ] && CC_TECH="coco"
[ -e /dev/sev-guest ] && CC_TECH="amd-sev-snp"
[ -e /dev/tdx_guest ] && CC_TECH="intel-tdx"
if [ -z "$CC_TECH" ] && [ -n "$DMESG_HEAD" ]; then
	case "$DMESG_HEAD" in
	*"Memory Encryption Features active"*)
		case "$DMESG_HEAD" in
		*"SEV-SNP"*) CC_TECH="amd-sev-snp" ;;
		*"SEV-ES"*) CC_TECH="amd-sev-es" ;;
		*"Intel TDX"* | *"TDX"*) CC_TECH="intel-tdx" ;;
		*"AMD SEV"* | *SEV*) CC_TECH="amd-sev" ;;
		esac
		;;
	esac
fi

# ---- Signal: virtio topology ------------------------------------------------
# WHICH devices the VMM chose to expose, and over WHICH transport, is what separates two KVM guests
# that otherwise look identical. Firecracker gives a guest virtio-blk + virtio-net (classically over
# MMIO, with `pci=off`); libkrun gives it virtio-fs as the ROOT plus virtio-console and, in its
# default TSI mode, no network device at all; Cloud Hypervisor and stock QEMU put everything on PCI.
#
# Read from the device-id register rather than the bound driver's name: the id is the hardware fact
# and is stable across kernel versions, while driver names are not (vsock binds as
# `vmw_vsock_virtio_transport`, virtio-fs as `virtiofs`). Ids are the virtio spec's §5 numbering.
VIRTIO_TRANSPORT="none"
VIRTIO_DEVICES=""
_virtio_name() {
	case "$1" in
	1) printf 'net' ;;
	2) printf 'blk' ;;
	3) printf 'console' ;;
	4) printf 'rng' ;;
	5) printf 'balloon' ;;
	9) printf '9p' ;;
	16) printf 'gpu' ;;
	18) printf 'input' ;;
	19) printf 'vsock' ;;
	26) printf 'fs' ;;
	27) printf 'pmem' ;;
	*) printf 'id%s' "$1" ;;
	esac
}
_scan_virtio() {
	local dev id path saw_pci=0 saw_mmio=0
	local -a names=()
	for dev in /sys/bus/virtio/devices/*; do
		[ -d "$dev" ] || continue
		id=""
		[ -r "$dev/device" ] && id="$(tr -d '\n' <"$dev/device" 2>/dev/null)"
		case "$id" in
		0x[0-9a-fA-F]* | [0-9]*) names+=("$(_virtio_name "$((id))")") ;;
		esac
		path="$(readlink -f "$dev" 2>/dev/null)"
		case "$path" in
		# A virtio device's parent is either a PCI function (`…/pci0000:00/0000:00:01.0/virtio0`) or
		# a platform device standing for an MMIO window (`…/platform/d0000000.virtio_mmio/virtio0`).
		*/pci[0-9]*) saw_pci=1 ;;
		*/platform/*) saw_mmio=1 ;;
		esac
	done
	if [ ${#names[@]} -gt 0 ]; then
		VIRTIO_DEVICES="$(printf '%s\n' "${names[@]}" | joinset)"
	fi
	if [ "$saw_mmio" = 1 ] && [ "$saw_pci" = 1 ]; then
		VIRTIO_TRANSPORT="mixed"
	elif [ "$saw_mmio" = 1 ]; then
		VIRTIO_TRANSPORT="mmio"
	elif [ "$saw_pci" = 1 ]; then
		VIRTIO_TRANSPORT="pci"
	fi
}
_scan_virtio
virtio_has() { case ",${VIRTIO_DEVICES}," in *",${1},"*) return 0 ;; esac; return 1; }

# ---- Signal: PCI vendors, block devices, network drivers --------------------
# The unique PCI VENDOR ids, not an lspci dump: four hex digits per vendor is compact, stable across
# runs of the same shape, and is exactly the discriminating part — 15ad is VMware, 80ee VirtualBox,
# 1414 Microsoft, 5853 XenSource, 1d0f Amazon, 1af4 Red Hat/virtio. A full device list would add a
# kilobyte of per-sandbox noise for no extra identification.
PCI_VENDORS=""
if [ -d /sys/bus/pci/devices ]; then
	PCI_VENDORS="$(cat /sys/bus/pci/devices/*/vendor 2>/dev/null | sed 's/^0x//' | joinset)"
fi
HAS_PCI="false"
[ -n "$PCI_VENDORS" ] && HAS_PCI="true"

# Top-level block device names: `vda` is virtio-blk, `xvda` Xen, `nvme0n1` a real or Nitro NVMe,
# `pmem0` a Kata/NVDIMM root, `loop*` a squashfs-backed image (Apptainer, snap).
BLOCK_DEVICES=""
for _blk in /sys/block/*; do
	[ -e "$_blk" ] || continue
	BLOCK_DEVICES="${BLOCK_DEVICES:+${BLOCK_DEVICES},}${_blk##*/}"
done

# Network drivers name the platform outright: `ena`/`vif` for AWS, `hv_netvsc` for Hyper-V/Azure,
# `vmxnet3` for VMware, `gve` for GCE, `virtio_net` for a virtio VMM, `veth` for a container's pipe.
# A veth is identified structurally (its `iflink` names an ifindex in ANOTHER namespace) because the
# driver symlink for a veth end does not exist.
NET_IFACES=""
NET_DRIVERS=""
HAS_VETH="false"
_scan_net() {
	local iface name driver ifindex iflink
	local -a drivers=()
	for iface in /sys/class/net/*; do
		[ -e "$iface" ] || continue
		name="${iface##*/}"
		[ "$name" = "lo" ] && continue
		NET_IFACES="${NET_IFACES:+${NET_IFACES},}${name}"
		driver="$(readlink -f "$iface/device/driver" 2>/dev/null)"
		if [ -n "$driver" ]; then
			drivers+=("${driver##*/}")
		else
			ifindex="$(readline "$iface/ifindex")"
			iflink="$(readline "$iface/iflink")"
			if [ -n "$iflink" ] && [ "$iflink" != "$ifindex" ]; then
				HAS_VETH="true"
				drivers+=("veth")
			fi
		fi
	done
	[ ${#drivers[@]} -gt 0 ] && NET_DRIVERS="$(printf '%s\n' "${drivers[@]}" | joinset)"
	return 0
}
_scan_net

# ---- Signal: the root filesystem, the mount vocabulary, and consoles --------
# `virtiofs` as the root is a libkrun/Kata shape; a real block device (`/dev/vda`) with ext4 is the
# microVM-with-a-disk shape; `overlay` is a container; gVisor names its own overlay `overlayfs` and
# its gofer-backed mounts `9p`/`goferfs`, which no Linux kernel does.
#
# /proc/self/mountinfo, not `findmnt`: no tool dependency, and its post-"-" fields give fstype and
# source unambiguously even when the source contains spaces. The LAST entry for `/` is the effective
# one after any pivot/overlay.
ROOT_FSTYPE=""
ROOT_SOURCE=""
OVERLAY_UPPER=""
_root_line="$(awk '$5 == "/"' /proc/self/mountinfo 2>/dev/null | tail -1)"
if [ -n "$_root_line" ]; then
	ROOT_FSTYPE="$(printf '%s' "$_root_line" | awk '{for (i = 6; i <= NF; i++) if ($i == "-") { print $(i + 1); exit }}')"
	ROOT_SOURCE="$(printf '%s' "$_root_line" | awk '{for (i = 6; i <= NF; i++) if ($i == "-") { print $(i + 2); exit }}')"
	case "$_root_line" in
	*upperdir=*)
		OVERLAY_UPPER="${_root_line##*upperdir=}"
		OVERLAY_UPPER="${OVERLAY_UPPER%%,*}"
		OVERLAY_UPPER="${OVERLAY_UPPER%% *}"
		;;
	esac
fi
if [ -z "$ROOT_FSTYPE" ]; then
	# gVisor and some minimal images expose /proc/mounts but not /proc/self/mountinfo.
	ROOT_FSTYPE="$(awk '$2 == "/" { fs = $3 } END { print fs }' /proc/mounts 2>/dev/null)"
	ROOT_SOURCE="$(awk '$2 == "/" { src = $1 } END { print src }' /proc/mounts 2>/dev/null)"
fi
# The SET of filesystem types mounted anywhere — one compact string that carries most of the mount
# evidence without any path: `virtiofs` (libkrun/Kata), `fuse.sysboxfs` (Sysbox), `9p`/`goferfs`
# (gVisor), `squashfs` (Apptainer/snap), `overlay` (OCI), `zfs`/`aufs` (older engines).
MOUNT_FSTYPES="$(awk '{for (i = 6; i <= NF; i++) if ($i == "-") { print $(i + 1); break }}' /proc/self/mountinfo 2>/dev/null | joinset)"
[ -z "$MOUNT_FSTYPES" ] && MOUNT_FSTYPES="$(awk '{print $3}' /proc/mounts 2>/dev/null | joinset)"
fstype_present() { case ",${MOUNT_FSTYPES}," in *",${1},"*) return 0 ;; esac; return 1; }
HAS_VIRTIOFS="false"
fstype_present virtiofs && HAS_VIRTIOFS="true"
# Sysbox virtualizes procfs/sysfs through a FUSE daemon mounted as `sysboxfs` over /proc/sys,
# /proc/uptime and friends — a live mount, and the one unambiguous Sysbox tell from inside.
SYSBOXFS="false"
grep -qm1 'sysboxfs' /proc/mounts 2>/dev/null && SYSBOXFS="true"
# runc-family engines mask kernel-introspection paths by bind-mounting /dev/null over them, which
# leaves them visible in mountinfo. Nothing bakes this into an image.
MASKED_PROC="false"
grep -qEm1 ' /proc/(kcore|keys|timer_list|sched_debug|latency_stats) ' /proc/self/mountinfo 2>/dev/null &&
	MASKED_PROC="true"

# Console and firmware shape: /dev/hvc0 is virtio-console (libkrun, Cloud Hypervisor, Kata, Xen);
# /dev/ttyS0 is an emulated 8250 (Firecracker, QEMU, most clouds). /dev/kvm inside the sandbox means
# nested virtualization is available to the workload, which is itself a capability worth recording.
HAS_SMBIOS="false"
[ -d /sys/class/dmi/id ] && HAS_SMBIOS="true"
HAS_ACPI="false"
[ -d /sys/firmware/acpi ] && HAS_ACPI="true"
FIRMWARE_NODES=""
for _fw in /sys/firmware/*; do
	[ -e "$_fw" ] || continue
	FIRMWARE_NODES="${FIRMWARE_NODES:+${FIRMWARE_NODES},}${_fw##*/}"
done
HAS_HVC0="false"
[ -c /dev/hvc0 ] && HAS_HVC0="true"
HAS_TTYS0="false"
[ -c /dev/ttyS0 ] && HAS_TTYS0="true"
HAS_VSOCK="false"
{ [ -c /dev/vsock ] || [ -c /dev/vhost-vsock ]; } && HAS_VSOCK="true"
HAS_KVM="false"
[ -c /dev/kvm ] && HAS_KVM="true"
HAS_FUSE="false"
[ -c /dev/fuse ] && HAS_FUSE="true"
HAS_TUN="false"
[ -c /dev/net/tun ] && HAS_TUN="true"

# ---- Signal: container-layer markers ----------------------------------------
# Split deliberately into two tiers, because conflating them is the single most common way to get
# this wrong — and it is exactly what systemd-detect-virt does:
#
#   WEAK      — a file or environment variable that a container engine writes but that also survives
#               being baked into an image. `/.dockerenv` and `/run/systemd/container` are copied into
#               a rootfs built from a container image and then boot inside a microVM.
#   STRUCTURAL— live kernel state that cannot survive an image copy: a fuse mount, a user-namespace
#               id map, a capability the boundary dropped, a masked /proc entry, a veth pipe, an
#               engine-owned cgroup path or overlay upperdir.
#
# Weak markers are scored far below the threshold at which a container runtime is claimed, so they
# can corroborate a structural signal but never carry a verdict alone.
CONTAINER_MARKERS=""
_add_marker() { CONTAINER_MARKERS="${CONTAINER_MARKERS:+${CONTAINER_MARKERS},}$1"; }
[ -f /.dockerenv ] && _add_marker "dockerenv"
[ -f /run/.containerenv ] && _add_marker "containerenv"
CONTAINER_ENV_VALUE=""
if [ -r /proc/1/environ ]; then
	CONTAINER_ENV_VALUE="$(tr '\0' '\n' </proc/1/environ 2>/dev/null | sed -n 's/^container=//p' | head -1)"
fi
[ -n "$CONTAINER_ENV_VALUE" ] && _add_marker "container-env=${CONTAINER_ENV_VALUE}"
SYSTEMD_CONTAINER_FILE="$(readline /run/systemd/container)"
[ -n "$SYSTEMD_CONTAINER_FILE" ] && _add_marker "systemd-container=${SYSTEMD_CONTAINER_FILE}"
[ -n "${SINGULARITY_CONTAINER:-}${APPTAINER_CONTAINER:-}" ] && _add_marker "apptainer-env"
[ -e /.singularity.d ] && _add_marker "singularity-dir"
[ -n "${KUBERNETES_SERVICE_HOST:-}" ] && _add_marker "kubernetes-env"
[ -d /var/run/secrets/kubernetes.io ] && _add_marker "kubernetes-serviceaccount"
[ -d /run/host-services ] && _add_marker "docker-desktop"
[ -d /run/firejail ] && _add_marker "firejail"
[ -d /proc/vz ] && _add_marker "openvz"

# The engine that owns our cgroup, from the cgroup PATH only — never the path itself, which embeds a
# per-sandbox container id.
CGROUP_ENGINE=""
_cgroup_raw="$(cat /proc/self/cgroup 2>/dev/null)"
case "$_cgroup_raw" in
*sysbox*) CGROUP_ENGINE="sysbox" ;;
*kubepods*) CGROUP_ENGINE="kubernetes" ;;
*libpod*) CGROUP_ENGINE="podman" ;;
*lxc*) CGROUP_ENGINE="lxc" ;;
*crio*) CGROUP_ENGINE="cri-o" ;;
*containerd*) CGROUP_ENGINE="containerd" ;;
*/docker*) CGROUP_ENGINE="docker" ;;
*machine.slice*) CGROUP_ENGINE="nspawn" ;;
esac
# Same treatment for the overlay upperdir: keep the engine it names, drop the id it contains.
OVERLAY_ENGINE=""
case "$OVERLAY_UPPER" in
/var/lib/docker/*) OVERLAY_ENGINE="docker" ;;
/var/lib/containerd/* | /run/containerd/*) OVERLAY_ENGINE="containerd" ;;
# Podman and CRI-O share the containers/storage layout byte for byte, so the upperdir alone cannot
# separate them. Attributed to the more common one here and left to the cgroup path and the LSM
# profile — both of which DO distinguish them — to override.
/var/lib/containers/* | /home/*/.local/share/containers/* | /var/run/containers/*) OVERLAY_ENGINE="podman" ;;
/var/lib/sysbox/*) OVERLAY_ENGINE="sysbox" ;;
/var/lib/lxd/* | /var/lib/incus/*) OVERLAY_ENGINE="lxd" ;;
esac

# A remapped user namespace. "0 0 4294967295" is the initial namespace's identity map; anything else
# means someone put us inside a userns (Sysbox always does, as do rootless podman and unprivileged
# LXD). Cannot be baked into an image.
USERNS_MAPPED="false"
_uidmap="$(awk 'NR == 1 { print $1, $2, $3 }' /proc/self/uid_map 2>/dev/null)"
[ -n "$_uidmap" ] && [ "$_uidmap" != "0 0 4294967295" ] && USERNS_MAPPED="true"

# CAP_SYS_ADMIN (bit 21) is in a VM guest's root capability set and out of a default OCI container's.
# From the CapEff bitmask, NOT from `capsh --print | grep cap_sys_admin`: capsh also prints the
# BOUNDING set, which lists cap_sys_admin on a container that does not hold it — a false positive on
# the one bit this test exists to read.
CAP_EFF="$(awk '/^CapEff:/ { print $2 }' /proc/self/status 2>/dev/null)"
CAP_SYS_ADMIN="unknown"
if [[ "$CAP_EFF" =~ ^[0-9a-fA-F]{1,16}$ ]]; then
	if ((0x$CAP_EFF & 0x200000)); then CAP_SYS_ADMIN="true"; else CAP_SYS_ADMIN="false"; fi
fi
SECCOMP_MODE="$(awk '/^Seccomp:/ { print $2 }' /proc/self/status 2>/dev/null)"
SECCOMP_FILTERS="$(awk '/^Seccomp_filters:/ { print $2 }' /proc/self/status 2>/dev/null)"
NO_NEW_PRIVS="$(awk '/^NoNewPrivs:/ { print $2 }' /proc/self/status 2>/dev/null)"
LSM="$(readline /sys/kernel/security/lsm)"
# An AppArmor profile named by the engine that applied it — `docker-default` and `crio-default` are
# engine self-declarations that no image can fake, since the profile is attached at container start.
LSM_PROFILE="$(readline /proc/self/attr/current)"
CGROUP_VERSION="1"
[ -f /sys/fs/cgroup/cgroup.controllers ] && CGROUP_VERSION="2"
CGROUP_RW="false"
[ -w /sys/fs/cgroup ] && CGROUP_RW="true"
PID1_COMM="$(readline /proc/1/comm)"
PID1_EXE="$(readlink /proc/1/exe 2>/dev/null || true)"
KERNEL_BUILD="$(tr -d '\n' </proc/version 2>/dev/null)"
KERNEL_BUILD_LC="${KERNEL_BUILD,,}"

# ---- Signal: gVisor ---------------------------------------------------------
# gVisor is not a hypervisor and not a namespace: it is a user-space kernel, so every machine-layer
# signal is describing a machine that does not exist. Detected before anything else so no VMM rule
# can fire on its synthetic hardware.
GVISOR="false"
GVISOR_WHY=""
_uname_r="$(uname -r 2>/dev/null || true)"
if [[ "$KERNEL_BUILD_LC" == *gvisor* ]] || [[ "${_uname_r,,}" == *gvisor* ]]; then
	# The sentry names itself in the version string it synthesizes (Modal's build reports kernel
	# release `4.19.0-gvisor`).
	GVISOR="true"
	GVISOR_WHY="kernel version string names gVisor"
elif [[ "${DMESG_HEAD,,}" == *gvisor* ]] || [[ "${DMESG_HEAD,,}" == *runsc* ]]; then
	# gVisor's fake boot log opens with "Starting gVisor...".
	GVISOR="true"
	GVISOR_WHY="boot log carries the gVisor banner"
elif [ "$HAS_ACPI" = "false" ] && [ "$HAS_SMBIOS" = "false" ] && [ "$VIRTIO_TRANSPORT" = "none" ] &&
	{ fstype_present overlayfs || fstype_present goferfs || fstype_present 9p; }; then
	# No firmware, no virtio, and a filesystem type name Linux does not use: the real overlay driver
	# is `overlay`, and `overlayfs`/`goferfs` are the sentry's own spellings.
	GVISOR="true"
	GVISOR_WHY="no firmware or virtio, and a gVisor-only filesystem type is mounted"
fi

# ---- Signal: Kata ------------------------------------------------------------
# Resolved BEFORE scoring because it is load-bearing in both layers. Kata is a container runtime
# (scored below) whose guest is a microVM booted by QEMU, Firecracker or Cloud Hypervisor — and that
# guest presents virtio-fs plus a virtio-console and, on a pmem root, no virtio-blk. That is exactly
# libkrun's device shape, so without this the machine layer confidently names the wrong VMM on every
# Kata sandbox.
KATA_DECLARED="false"
KATA_INFERRED="false"
case "${DMI_LC} ${KERNEL_CMDLINE,,}" in
*"kata containers"* | *kata-containers* | *kata-agent*) KATA_DECLARED="true" ;;
esac
[ -d /run/kata-containers ] && KATA_DECLARED="true"
if cmdline_has "agent." && { [ "$HAS_VSOCK" = "true" ] || [ "$HAS_VIRTIOFS" = "true" ]; }; then
	# The bare `agent.` prefix is corroborated by the transport that agent needs (vsock) or the share
	# it mounts (virtio-fs), so an unrelated `agent.*` boot option cannot claim Kata on its own.
	KATA_INFERRED="true"
fi

# ---- Scoring ----------------------------------------------------------------
# Two independent ranked lists. `<layer>_ORDER` is authored most-specific-first and is the tie-break,
# so a generic bucket can never win a tie against a named runtime.
declare -A M_SCORE=() M_WHY=() M_DECL=()
declare -A C_SCORE=() C_WHY=() C_DECL=()
MACHINE_ORDER=(
	firecracker libkrun cloud-hypervisor crosvm qemu-kvm
	amazon-nitro gce azure hyper-v xen vmware virtualbox parallels apple-virtualization
	digitalocean openstack nutanix proxmox alibaba oracle-cloud bhyve uml wsl2
	microvm-unidentified vm-unidentified bare-metal
)
CONTAINER_ORDER=(
	gvisor kata-containers sysbox lxd lxc systemd-nspawn openvz apptainer firejail
	podman cri-o containerd-runc docker-runc oci-container
)
m() {
	M_SCORE["$1"]=$((${M_SCORE["$1"]:-0} + $2))
	M_WHY["$1"]="${M_WHY[$1]:-}${M_WHY[$1]:+|}$3 (${2})"
	[ "$2" -ge 100 ] && M_DECL["$1"]=1
	return 0
}
c() {
	C_SCORE["$1"]=$((${C_SCORE["$1"]:-0} + $2))
	C_WHY["$1"]="${C_WHY[$1]:-}${C_WHY[$1]:+|}$3 (${2})"
	[ "$2" -ge 100 ] && C_DECL["$1"]=1
	return 0
}

# --- Machine layer: firmware self-declaration, tier 1 (ACPI) ---
# These ids are compiled into each VMM's ACPI table builder, so a match is the VMM naming itself.
case "$ACPI_OEM" in
FIRECK) m firecracker 100 "ACPI OEM id FIRECK" ;;
CLOUDH) m cloud-hypervisor 100 "ACPI OEM id CLOUDH" ;;
BOCHS) m qemu-kvm 100 "ACPI OEM id BOCHS (SeaBIOS-built QEMU tables)" ;;
CROSVM) m crosvm 100 "ACPI OEM id CROSVM" ;;
KRUN | LIBKRUN) m libkrun 100 "ACPI OEM id ${ACPI_OEM}" ;;
AMAZON) m amazon-nitro 100 "ACPI OEM id AMAZON" ;;
VRTUAL | MSFTVM) m hyper-v 100 "ACPI OEM id ${ACPI_OEM}" ;;
Xen | XEN | XENVMM) m xen 100 "ACPI OEM id ${ACPI_OEM}" ;;
VBOX) m virtualbox 100 "ACPI OEM id VBOX" ;;
Apple | APPLE) m apple-virtualization 100 "ACPI OEM id ${ACPI_OEM}" ;;
Google | GOOGLE) m gce 100 "ACPI OEM id ${ACPI_OEM}" ;;
esac
case "$ACPI_LC" in
*bxpc*) m qemu-kvm 60 "ACPI creator id BXPC (SeaBIOS)" ;;
esac

# --- Machine layer: firmware self-declaration, tier 2 (SMBIOS) ---
# This describes the machine OUR KERNEL sees, so inside a container it correctly names the host's
# hypervisor and the container layer below is what confines the workload.
case "$DMI_LC" in
*firecracker*) m firecracker 100 "SMBIOS names Firecracker" ;;
esac
case "$DMI_LC" in
*"cloud hypervisor"* | *cloud-hypervisor*) m cloud-hypervisor 100 "SMBIOS names Cloud Hypervisor" ;;
esac
case "$DMI_LC" in
*libkrun* | *krunvm*) m libkrun 100 "SMBIOS names libkrun" ;;
esac
case "$DMI_LC" in
*"amazon ec2"* | *amazonec2*) m amazon-nitro 100 "SMBIOS names Amazon EC2" ;;
esac
case "$DMI_LC" in
*"google compute engine"* | google*) m gce 100 "SMBIOS names Google Compute Engine" ;;
esac
case "$DMI_LC" in
*"microsoft corporation"* | *"virtual machine"*) m hyper-v 100 "SMBIOS names Microsoft/Hyper-V" ;;
esac
case "$DMI_LC" in
*vmware*) m vmware 100 "SMBIOS names VMware" ;;
esac
case "$DMI_LC" in
*virtualbox* | *innotek*) m virtualbox 100 "SMBIOS names VirtualBox" ;;
esac
case "$DMI_LC" in
*parallels*) m parallels 100 "SMBIOS names Parallels" ;;
esac
case "$DMI_LC" in
*"apple virtualization"*) m apple-virtualization 100 "SMBIOS names Apple Virtualization" ;;
esac
case "$DMI_LC" in
*digitalocean*) m digitalocean 100 "SMBIOS names DigitalOcean" ;;
esac
case "$DMI_LC" in
*openstack*) m openstack 100 "SMBIOS names OpenStack" ;;
esac
case "$DMI_LC" in
*nutanix*) m nutanix 100 "SMBIOS names Nutanix" ;;
esac
case "$DMI_LC" in
*alibaba*) m alibaba 100 "SMBIOS names Alibaba Cloud" ;;
esac
case "$DMI_LC" in
*oraclecloud* | *"oracle cloud"*) m oracle-cloud 100 "SMBIOS names Oracle Cloud" ;;
esac
case "$DMI_LC" in
*bhyve*) m bhyve 100 "SMBIOS names bhyve" ;;
esac
case "$DMI_LC" in
*xen*) m xen 100 "SMBIOS names Xen" ;;
esac
case "$DMI_LC" in
*pve* | *proxmox*) m proxmox 100 "SMBIOS/BIOS version names Proxmox" ;;
esac
# QEMU last, and only if nothing more specific already matched: every QEMU-derived platform above
# (Proxmox, OpenStack, Alibaba, …) also carries a QEMU string, and the platform is the better answer.
case "$DMI_LC" in
*qemu* | *seabios* | *bochs*) m qemu-kvm 60 "SMBIOS names QEMU/SeaBIOS" ;;
esac

# --- Machine layer: paravirt buses, drivers and PCI vendors ---
[ "$HAS_XEN_NODE" = "true" ] && m xen 100 "kernel exposes a Xen hypervisor node"
[ "$HAS_VMBUS" = "true" ] && m hyper-v 100 "kernel exposes the Hyper-V VMBus"
case "$KERNEL_BUILD_LC" in
*microsoft*wsl* | *wsl2*) m wsl2 100 "kernel version string names WSL" ;;
esac
grep -qm1 'User Mode Linux' /proc/cpuinfo 2>/dev/null && m uml 100 "/proc/cpuinfo reports User Mode Linux"
for _drv in ${NET_DRIVERS//,/ }; do
	case "$_drv" in
	ena | efa) m amazon-nitro 60 "network driver ${_drv} is AWS-only" ;;
	hv_netvsc) m hyper-v 60 "network driver hv_netvsc is Hyper-V-only" ;;
	vmxnet3) m vmware 60 "network driver vmxnet3 is VMware-only" ;;
	gve) m gce 60 "network driver gve is Google-Compute-Engine-only" ;;
	xen-netfront) m xen 60 "network driver xen-netfront is Xen-only" ;;
	esac
done
for _pciv in ${PCI_VENDORS//,/ }; do
	case "$_pciv" in
	15ad) m vmware 60 "PCI vendor 15ad (VMware)" ;;
	80ee) m virtualbox 60 "PCI vendor 80ee (VirtualBox)" ;;
	1414) m hyper-v 60 "PCI vendor 1414 (Microsoft)" ;;
	5853) m xen 60 "PCI vendor 5853 (XenSource)" ;;
	1d0f) m amazon-nitro 60 "PCI vendor 1d0f (Amazon)" ;;
	1ab8) m parallels 60 "PCI vendor 1ab8 (Parallels)" ;;
	esac
done
case "$BLOCK_DEVICES" in
*xvda*) m xen 30 "Xen blkfront root device" ;;
esac

# --- Machine layer: boot-argument and device-topology signatures ---
# Reached when no firmware identity exists at all, which is the normal case for the minimal VMMs.
if cmdline_has "rootfstype=virtiofs" || cmdline_has "init=/init.krun" || [ "$ROOT_FSTYPE" = "virtiofs" ]; then
	# Rooting the guest on virtio-fs — no block device at all — is libkrun's model. Kata also shares
	# files over virtio-fs but boots from a block or pmem root, which scores separately below.
	m libkrun 60 "guest is rooted on virtio-fs"
fi
if [ "$HAS_VIRTIOFS" = "true" ] && [ "$HAS_HVC0" = "true" ] && ! virtio_has blk; then
	m libkrun 60 "virtio-fs and virtio-console present with no virtio-blk"
fi
cmdline_has "no-kvmapf" && m libkrun 30 "no-kvmapf is in libkrun's default command line"
if cmdline_has "reboot=k" && cmdline_has "panic=1"; then
	m firecracker 60 "Firecracker's default boot arguments"
fi
# `pci=off` and `virtio_mmio.device` are Firecracker's classic companions but are no longer required:
# recent Firecracker can attach virtio over PCIe, so they add weight without being a precondition.
cmdline_has "pci=off" && m firecracker 30 "pci=off, Firecracker's default"
cmdline_has "virtio_mmio.device" && m firecracker 30 "explicit virtio-mmio device windows"
cmdline_has "nvme_core.io_timeout" && m amazon-nitro 30 "EC2's default NVMe timeout boot argument"
cmdline_has "console=hvc0" && {
	m libkrun 15 "console on virtio-console"
	m cloud-hypervisor 15 "console on virtio-console"
}
cmdline_has "console=ttyS0" && m firecracker 15 "console on an emulated 8250"
# Contradictions. Firecracker and libkrun ship no SMBIOS at all, so its presence argues against them
# far more strongly than any of their supporting signals argue for them.
if [ "$HAS_SMBIOS" = "true" ]; then
	m firecracker -80 "SMBIOS tables are present; Firecracker exposes none"
	m libkrun -60 "SMBIOS tables are present; libkrun exposes none"
fi
virtio_has blk && m libkrun -40 "a virtio-blk device is present; libkrun boots without one"
if [ "$KATA_DECLARED" = "true" ] || [ "$KATA_INFERRED" = "true" ]; then
	m libkrun -60 "the virtio-fs/virtio-console shape here belongs to a Kata guest, not to libkrun"
fi

# --- Machine layer: generic buckets, capped below any named match ---
if [ "$HYPERVISOR_FLAG" = "true" ] || [ -n "$CPU_HYPERVISOR" ]; then
	if [ "$HAS_SMBIOS" = "false" ] && [ "$VIRTIO_TRANSPORT" != "none" ]; then
		m microvm-unidentified 45 "virtio guest with no SMBIOS: a minimal VMM, not identified"
	elif [ "$VIRTIO_TRANSPORT" = "mmio" ]; then
		m microvm-unidentified 45 "virtio over MMIO: a minimal VMM, not identified"
	fi
	m vm-unidentified 40 "CPUID reports a hypervisor"
	m bare-metal -200 "CPUID reports a hypervisor"
elif [ "$CPUINFO_FLAGS" = "true" ]; then
	# An x86 `flags` line WITHOUT the hypervisor bit is positive evidence of bare metal — no VMM
	# leaves it clear. Gated on the line existing so an aarch64 guest, which has no such bit to miss,
	# stays unidentified instead of being declared bare metal.
	m bare-metal 60 "x86 CPUID flags present without the hypervisor bit"
fi

# --- Container layer ---
if [ "$GVISOR" = "true" ]; then
	# gVisor is an OCI runtime whose boundary is a user-space kernel, so it belongs to this layer even
	# though it presents a machine. Only the fs-shape fallback is an inference rather than a
	# self-declaration, so it scores below the confirmed tier.
	case "$GVISOR_WHY" in
	*"filesystem type"*) c gvisor 60 "$GVISOR_WHY" ;;
	*) c gvisor 100 "$GVISOR_WHY" ;;
	esac
fi
[ "$SYSBOXFS" = "true" ] && c sysbox 100 "sysboxfs is mounted over procfs"
{ [ -S /run/sysbox/sysbox-fs.sock ] || [ -S /run/sysbox/sysbox-mgr.sock ]; } && c sysbox 100 "a Sysbox runtime socket is present"
[ "$CGROUP_ENGINE" = "sysbox" ] && c sysbox 100 "cgroup path is owned by Sysbox"
[ "$KATA_DECLARED" = "true" ] && c kata-containers 100 "Kata names itself in SMBIOS, the boot arguments, or its agent runtime directory"
[ "$KATA_INFERRED" = "true" ] && c kata-containers 60 "Kata agent boot arguments with vsock or virtio-fs present"
[ -S /dev/lxd/sock ] && c lxd 100 "the LXD/Incus guest socket is present"
[ "$OVERLAY_ENGINE" = "lxd" ] && c lxd 100 "overlay upperdir is owned by LXD/Incus"
{ [ -d /dev/.lxc ] || [ "$CONTAINER_ENV_VALUE" = "lxc" ] || [ "$CGROUP_ENGINE" = "lxc" ]; } &&
	c lxc 100 "LXC names itself in a live marker"
[ "$CONTAINER_ENV_VALUE" = "systemd-nspawn" ] && c systemd-nspawn 100 "pid 1 was started by systemd-nspawn"
[ "$CGROUP_ENGINE" = "nspawn" ] && c systemd-nspawn 60 "cgroup path is a machine.slice scope"
{ [ -d /proc/vz ] && [ ! -d /proc/bc ]; } && c openvz 100 "OpenVZ guest interfaces are present"
{ [ -e /.singularity.d ] || [ -n "${SINGULARITY_CONTAINER:-}${APPTAINER_CONTAINER:-}" ]; } &&
	c apptainer 100 "Apptainer/Singularity names itself"
[ -d /run/firejail ] && c firejail 100 "Firejail's runtime directory is present"
{ [ "$CONTAINER_ENV_VALUE" = "podman" ] || [ "$OVERLAY_ENGINE" = "podman" ] || [ "$CGROUP_ENGINE" = "podman" ]; } &&
	c podman 100 "Podman names itself in a live marker"
[ "$CGROUP_ENGINE" = "cri-o" ] && c cri-o 100 "CRI-O owns the cgroup path"
{ [ "$OVERLAY_ENGINE" = "docker" ] || [ "$CGROUP_ENGINE" = "docker" ]; } && c docker-runc 100 "Docker owns the cgroup path or the overlay upperdir"
{ [ "$OVERLAY_ENGINE" = "containerd" ] || [ "$CGROUP_ENGINE" = "containerd" ] || [ "$CGROUP_ENGINE" = "kubernetes" ]; } &&
	c containerd-runc 100 "containerd owns the cgroup path, the overlay upperdir, or a kubepods scope"
# The LSM profile is attached by the engine at container start and cannot be baked into an image.
case "${LSM_PROFILE,,}" in
*docker-default*) c docker-runc 100 "AppArmor profile docker-default is applied" ;;
*crio-default*) c cri-o 100 "AppArmor profile crio-default is applied" ;;
esac

# Structural containment — live state that no image copy reproduces. Enough of it names a container
# even when no engine does.
[ "$MASKED_PROC" = "true" ] && c oci-container 30 "kernel-introspection paths under /proc are masked"
[ "$CAP_SYS_ADMIN" = "false" ] && c oci-container 30 "CAP_SYS_ADMIN has been dropped"
[ "$ROOT_FSTYPE" = "overlay" ] && c oci-container 20 "root filesystem is an overlay"
[ "$HAS_VETH" = "true" ] && c oci-container 20 "a veth pipe into another network namespace is present"
if [ "$USERNS_MAPPED" = "true" ]; then
	c oci-container 20 "running inside a remapped user namespace"
	c sysbox 20 "Sysbox always remaps the user namespace"
	c lxd 10 "unprivileged LXD remaps the user namespace"
	c podman 10 "rootless Podman remaps the user namespace"
fi
# Weak markers. Scored far below CONTAINER_MIN_SCORE so they can corroborate but never carry a
# verdict — the systemd-detect-virt trap this whole tiering exists to avoid.
case "$CONTAINER_MARKERS" in
*dockerenv*) c docker-runc 15 "/.dockerenv is present (weak: survives an image copy)" ;;
esac
case "$CONTAINER_MARKERS" in
*containerenv*) c podman 15 "/run/.containerenv is present (weak: survives an image copy)" ;;
esac
case "$CONTAINER_MARKERS" in
*kubernetes*) c containerd-runc 15 "a Kubernetes service account or environment is present" ;;
esac
[ -n "$SYSTEMD_CONTAINER_FILE" ] && c oci-container 15 "/run/systemd/container names a container (weak: survives an image copy)"
[ -n "$CONTAINER_ENV_VALUE" ] && c oci-container 15 "pid 1 carries container=${CONTAINER_ENV_VALUE} (weak: survives an image copy)"

# ---- Rank -------------------------------------------------------------------
# Sorted by score descending, then by the authored specificity order — never alphabetically, so a
# tie resolves toward the more specific candidate rather than the earlier letter.
_rank() { sort -t'	' -k3,3nr -k1,1n; }
MACHINE_ROWS=""
for _i in "${!MACHINE_ORDER[@]}"; do
	_cand="${MACHINE_ORDER[_i]}"
	[ "${M_SCORE[$_cand]:-0}" -gt 0 ] || continue
	MACHINE_ROWS+="${_i}	${_cand}	${M_SCORE[$_cand]}	${M_WHY[$_cand]:-}	${M_DECL[$_cand]:-0}"$'\n'
done
CONTAINER_ROWS=""
for _i in "${!CONTAINER_ORDER[@]}"; do
	_cand="${CONTAINER_ORDER[_i]}"
	[ "${C_SCORE[$_cand]:-0}" -gt 0 ] || continue
	CONTAINER_ROWS+="${_i}	${_cand}	${C_SCORE[$_cand]}	${C_WHY[$_cand]:-}	${C_DECL[$_cand]:-0}"$'\n'
done
[ -n "$MACHINE_ROWS" ] && MACHINE_ROWS="$(printf '%s' "$MACHINE_ROWS" | _rank)"
[ -n "$CONTAINER_ROWS" ] && CONTAINER_ROWS="$(printf '%s' "$CONTAINER_ROWS" | _rank)"

_field() { printf '%s\n' "$1" | awk -F'\t' -v n="$2" -v r="$3" 'NR == r { print $n }'; }
MACHINE_VMM="$(_field "$MACHINE_ROWS" 2 1)"
MACHINE_SCORE="$(_field "$MACHINE_ROWS" 3 1)"
MACHINE_WHY="$(_field "$MACHINE_ROWS" 4 1)"
MACHINE_DECL="$(_field "$MACHINE_ROWS" 5 1)"

# The runner-up that CONFIDENCE is measured against skips the generic buckets, which is not the same
# question as the runner-up that gets displayed. "Some unidentified microVM" scoring 45 behind a
# Firecracker scoring 175 is not a competing hypothesis — it is the same finding, stated less
# precisely, and letting it narrow the margin would downgrade a firmware self-declaration to
# `likely` on exactly the sandboxes the probe reads best. A generic bucket that WINS is still ranked
# and reported normally; it just measures its own margin against whatever is next.
GENERIC_CANDIDATES=",microvm-unidentified,vm-unidentified,oci-container,"
_runner_up() {
	local rows="$1" top="$2"
	case "$GENERIC_CANDIDATES" in
	*",${top},"*)
		printf '%s\n' "$rows" | awk -F'\t' 'NR == 2 { print $3 }'
		return 0
		;;
	esac
	printf '%s\n' "$rows" | awk -F'\t' -v generic="$GENERIC_CANDIDATES" \
		'NR > 1 && index(generic, "," $2 ",") == 0 { print $3; exit }'
}
MACHINE_RUNNER_UP="$(_runner_up "$MACHINE_ROWS" "$MACHINE_VMM")"
CONTAINER_RUNTIME="$(_field "$CONTAINER_ROWS" 2 1)"
CONTAINER_SCORE="$(_field "$CONTAINER_ROWS" 3 1)"
CONTAINER_WHY="$(_field "$CONTAINER_ROWS" 4 1)"
CONTAINER_DECL="$(_field "$CONTAINER_ROWS" 5 1)"
CONTAINER_RUNNER_UP="$(_runner_up "$CONTAINER_ROWS" "$CONTAINER_RUNTIME")"

# A container runtime is claimed only above this floor. Every weak marker is worth 15, so no
# combination of image residue reaches it without at least one structural signal.
CONTAINER_MIN_SCORE=40
if [ -z "$CONTAINER_RUNTIME" ] || [ "${CONTAINER_SCORE:-0}" -lt "$CONTAINER_MIN_SCORE" ]; then
	[ -n "$CONTAINER_RUNTIME" ] && CONTAINER_WHY="below the containment floor: ${CONTAINER_WHY}"
	CONTAINER_RUNTIME="none"
	CONTAINER_SCORE=0
fi
[ -n "$MACHINE_VMM" ] || MACHINE_VMM="unknown"
if [ "$GVISOR" = "true" ]; then
	# The sentry IS the kernel here; whatever runs under the runsc process is not observable from
	# inside, so naming a VMM would be an invention.
	MACHINE_VMM="not-observable"
	MACHINE_WHY="a user-space kernel hides the machine layer"
fi

# Confidence is a property of the evidence class, not of the arithmetic: a self-declaration with a
# clear margin is `confirmed`, an exclusive signature is `strong`, a shared one is `likely`.
_confidence() {
	local top="${1:-0}" runner="${2:-0}" declared="${3:-0}"
	if [ "$top" -eq 0 ]; then printf 'unknown'; return 0; fi
	if [ "$declared" = "1" ] && [ "$((top - runner))" -ge 40 ]; then printf 'confirmed'; return 0; fi
	if [ "$top" -ge 60 ] && [ "$((top - runner))" -ge 20 ]; then printf 'strong'; return 0; fi
	if [ "$top" -ge 40 ]; then printf 'likely'; return 0; fi
	printf 'weak'
}
MACHINE_CONFIDENCE="$(_confidence "${MACHINE_SCORE:-0}" "${MACHINE_RUNNER_UP:-0}" "${MACHINE_DECL:-0}")"
CONTAINER_CONFIDENCE="none"
[ "$CONTAINER_RUNTIME" != "none" ] &&
	CONTAINER_CONFIDENCE="$(_confidence "${CONTAINER_SCORE:-0}" "${CONTAINER_RUNNER_UP:-0}" "${CONTAINER_DECL:-0}")"

# ---- Headline ---------------------------------------------------------------
# The innermost boundary is the one that confines the workload, so a container layer outranks the
# machine layer whenever both are present.
if [ "$CONTAINER_RUNTIME" != "none" ]; then
	ISOLATION_RUNTIME="$CONTAINER_RUNTIME"
	ISOLATION_CONFIDENCE="$CONTAINER_CONFIDENCE"
	ISOLATION_WHY="$CONTAINER_WHY"
else
	ISOLATION_RUNTIME="$MACHINE_VMM"
	ISOLATION_CONFIDENCE="$MACHINE_CONFIDENCE"
	ISOLATION_WHY="$MACHINE_WHY"
fi
case "$ISOLATION_RUNTIME" in
gvisor) ISOLATION_CLASS="user-kernel" ;;
firecracker | libkrun | cloud-hypervisor | crosvm | kata-containers | microvm-unidentified) ISOLATION_CLASS="microvm" ;;
qemu-kvm | amazon-nitro | gce | azure | hyper-v | xen | vmware | virtualbox | parallels | apple-virtualization) ISOLATION_CLASS="vm" ;;
digitalocean | openstack | nutanix | proxmox | alibaba | oracle-cloud | bhyve | uml | wsl2 | vm-unidentified) ISOLATION_CLASS="vm" ;;
sysbox | lxc | lxd | podman | cri-o | systemd-nspawn | openvz | apptainer | firejail) ISOLATION_CLASS="container" ;;
docker-runc | containerd-runc | oci-container) ISOLATION_CLASS="container" ;;
bare-metal) ISOLATION_CLASS="bare-metal" ;;
*) ISOLATION_CLASS="unknown" ;;
esac
# Memory encryption does not change which VMM is running, only how much the host can see, so it is
# recorded as an attribute of the verdict rather than as a competing candidate.
[ -n "$CC_TECH" ] && ISOLATION_WHY="${ISOLATION_WHY}|confidential computing active: ${CC_TECH}"

# =============================================================================
# Docker-in-Docker readiness
# =============================================================================
# Whether a suite could run containers INSIDE this sandbox is a capability of the isolation
# boundary, and it is exactly the axis the techniques above differ on: a microVM with a real kernel
# usually can, a gVisor sandbox usually cannot (no overlayfs, no cgroup delegation), an unprivileged
# OCI container can only in rootless mode. Assessed passively — the probe asks an already-running
# daemon for its version and otherwise only reads prerequisites. It never starts dockerd, loads a
# module, mounts anything, or launches a container.
DOCKER_CLI="false"
have docker && DOCKER_CLI="true"
DOCKERD_BINARY="false"
have dockerd && DOCKERD_BINARY="true"
PODMAN_BINARY="false"
have podman && PODMAN_BINARY="true"
DOCKER_SOCKET="false"
{ [ -S /var/run/docker.sock ] || [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/docker.sock" ]; } && DOCKER_SOCKET="true"
DOCKER_REACHABLE="false"
DOCKER_SERVER_VERSION=""
DOCKER_STORAGE_DRIVER=""
if [ "$DOCKER_CLI" = "true" ] && have timeout; then
	# `timeout` is mandatory here rather than optional: `docker version` against a socket whose daemon
	# is wedged blocks indefinitely, and this probe runs inside a benchmark's time budget.
	DOCKER_SERVER_VERSION="$(timeout 3 docker version --format '{{.Server.Version}}' 2>/dev/null || true)"
	if [ -n "$DOCKER_SERVER_VERSION" ]; then
		DOCKER_REACHABLE="true"
		DOCKER_STORAGE_DRIVER="$(timeout 3 docker info --format '{{.Driver}}' 2>/dev/null || true)"
	fi
fi
OVERLAY_SUPPORTED="false"
grep -qw overlay /proc/filesystems 2>/dev/null && OVERLAY_SUPPORTED="true"
IS_ROOT="false"
[ "$(id -u)" = "0" ] && IS_ROOT="true"

DIND_MODE="unavailable"
DIND_READINESS="blocked"
DIND_REASONS=""
_dind_reason() { DIND_REASONS="${DIND_REASONS:+${DIND_REASONS}|}$1"; }
if [ "$DOCKER_REACHABLE" = "true" ]; then
	DIND_MODE="existing-daemon"
	DIND_READINESS="ready"
	_dind_reason "a Docker daemon answered (server ${DOCKER_SERVER_VERSION})"
	[ "$DOCKER_SOCKET" = "true" ] && _dind_reason "the daemon may be a mounted host socket rather than a nested one"
elif [ "$DOCKERD_BINARY" = "true" ] && [ "$IS_ROOT" = "true" ] && [ "$CAP_SYS_ADMIN" = "true" ] &&
	[ "$CGROUP_RW" = "true" ] && [ "$OVERLAY_SUPPORTED" = "true" ]; then
	DIND_MODE="nested-rootful"
	DIND_READINESS="likely-ready"
	_dind_reason "dockerd, root, CAP_SYS_ADMIN, a writable cgroup root and overlayfs are all available"
elif [ "$DOCKERD_BINARY" = "true" ] && [ "$HAS_FUSE" = "true" ] && [ "$USERNS_MAPPED" = "true" ]; then
	DIND_MODE="nested-rootless"
	DIND_READINESS="possibly-ready"
	_dind_reason "dockerd with /dev/fuse in a remapped user namespace suggests rootless mode could work"
else
	[ "$DOCKERD_BINARY" = "true" ] || [ "$PODMAN_BINARY" = "true" ] || _dind_reason "no dockerd or podman binary"
	[ "$IS_ROOT" = "true" ] || _dind_reason "not running as root"
	[ "$CAP_SYS_ADMIN" = "true" ] || _dind_reason "CAP_SYS_ADMIN is not held"
	[ "$CGROUP_RW" = "true" ] || _dind_reason "the cgroup root is not writable"
	{ [ "$OVERLAY_SUPPORTED" = "true" ] || [ "$HAS_FUSE" = "true" ]; } || _dind_reason "neither overlayfs nor /dev/fuse is available"
fi

# --- Machine shape -----------------------------------------------------------
# What actually distinguishes two sandboxes behind the same ASN. Without them a cross-vendor
# comparison cannot tell "different cloud" from "same cloud, different CPU generation".
CPU_MODEL="$(get "" sh -c "grep -m1 'model name' /proc/cpuinfo | cut -d: -f2 | xargs")"
[ -z "$CPU_MODEL" ] && CPU_MODEL="$(get "" sh -c "lscpu | grep -m1 'Model name:' | cut -d: -f2 | xargs")"
KERNEL="$(get "" uname -r)"
# Recorded because it qualifies the isolation signals as much as the results: the CPUID hypervisor
# bit only exists on x86, so `hypervisor_flag=false` means something different here than on aarch64.
ARCH="$(get "" uname -m)"
CORES="$(get "" nproc)"
RAM="$(get "" sh -c "free -h | awk '/Mem:/{print \$2}'")"

# --- Evidence table (report only) --------------------------------------------
evidence detector.systemd_virt "$VIRT" systemd-detect-virt authoritative
evidence detector.systemd_vm "$VIRT_VM" systemd-detect-virt authoritative
evidence detector.systemd_container "$VIRT_CONTAINER" systemd-detect-virt authoritative
evidence detector.virt_what "$VIRT_WHAT" virt-what strong
evidence acpi.oem_id "$ACPI_OEM" sysfs/dmesg self-declaring
evidence acpi.oem_table_id "$ACPI_OEM_TABLE" sysfs self-declaring
evidence acpi.creator_id "$ACPI_CREATOR" sysfs/dmesg self-declaring
evidence dmi.all "$DMI_ALL" sysfs/dmidecode self-declaring
evidence cpu.hypervisor_vendor "$CPU_HYPERVISOR" lscpu/dmesg strong
evidence cpu.hypervisor_flag "$HYPERVISOR_FLAG" procfs strong
evidence cpu.flags_line_present "$CPUINFO_FLAGS" procfs medium
evidence kernel.build "$KERNEL_BUILD" procfs strong
evidence kernel.cmdline_markers "$CMDLINE_MARKERS" procfs strong
evidence kernel.cmdline_raw "$KERNEL_CMDLINE" procfs "report-only"
evidence virtio.devices "$VIRTIO_DEVICES" sysfs strong
evidence virtio.transport "$VIRTIO_TRANSPORT" sysfs strong
evidence pci.vendors "$PCI_VENDORS" sysfs strong
evidence block.devices "$BLOCK_DEVICES" sysfs medium
evidence net.interfaces "$NET_IFACES" sysfs medium
evidence net.drivers "$NET_DRIVERS" sysfs strong
evidence fs.root "${ROOT_FSTYPE}${ROOT_SOURCE:+ on ${ROOT_SOURCE}}" mountinfo strong
evidence fs.types "$MOUNT_FSTYPES" mountinfo strong
evidence fs.overlay_engine "$OVERLAY_ENGINE" mountinfo strong

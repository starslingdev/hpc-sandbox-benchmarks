# jq builds the record wherever it exists, and it is the correct builder rather than the convenient
# one: every value here is untrusted device text, and --arg passes each one out-of-band so jq escapes
# it by construction. `$ARGS.named` collects those flags in order, so the key order matches the list
# above — and the printf fallback's.
#
# The ranked candidate arrays are attached only on the jq path, since building nested JSON by hand is
# exactly the hazard the fallback exists to avoid; the fallback marks itself `degraded` so a consumer
# can tell a jq-less sandbox from one where no candidate scored.
#
# The printf path cannot borrow jq's safety: json_result validates with jq, so on a sandbox without
# it there is no parser to catch a bad record either. What protects that path is _json_escape
# handling the control characters these sources really emit (lib/bench.sh) — worth caring about
# because this artifact has real consumers, packages/results/src/lib/host-metadata.ts flattening it
# into every Run's host metadata.
if have jq; then
	jq_args=()
	for ((i = 0; i < ${#RECORD_FIELDS[@]}; i += 2)); do
		jq_args+=(--arg "${RECORD_FIELDS[i]}" "${RECORD_FIELDS[i + 1]}")
	done
	# -c: one line, the shape the printf fallback below emits and the shape this artifact has always
	# had. A formatting difference between the jq and jq-less paths would be a difference between
	# sandboxes, not between records.
	jq -n -c "${jq_args[@]}" \
		--rawfile machine_rows <(printf '%s\n' "$MACHINE_ROWS") \
		--rawfile container_rows <(printf '%s\n' "$CONTAINER_ROWS") \
		'def rows: split("\n") | map(select(length > 0) | split("\t")
			| {id: .[1], score: (.[2] | tonumber), reasons: (.[3] | split("|"))});
		 {schema_version: "'"$SCHEMA_VERSION"'"} + $ARGS.named
		 + {machine_candidates: ($machine_rows | rows), container_candidates: ($container_rows | rows)}'
else
	{
		printf '{"schema_version":"%s","degraded":"no-jq"' "$SCHEMA_VERSION"
		for ((i = 0; i < ${#RECORD_FIELDS[@]}; i += 2)); do
			printf ',"%s":"%s"' "${RECORD_FIELDS[i]}" "$(_json_escape "${RECORD_FIELDS[i + 1]}")"
		done
		printf '}\n'
	}
fi | json_result "$(task_result_name)" || echo "(no structured provider record written)"


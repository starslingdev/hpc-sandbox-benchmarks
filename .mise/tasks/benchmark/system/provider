	confidential_computing "$CC_TECH"
	# … and the signals it was derived from, so the classification can be audited — or redone — from
	# the committed record without re-running the probe on hardware that may no longer exist. Every
	# one of these is stable for a given machine shape; nothing per-sandbox is recorded here (see the

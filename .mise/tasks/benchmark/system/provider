	virtualization "$VIRT"
	cpu_model "$CPU_MODEL"
	kernel "$KERNEL"
	cores "$CORES"
	ram "$RAM"
	prefix "$PREFIX"
	asn_source "$ASN_SOURCE"
	geo_source "$GEO_SOURCE"
	# The verdict, both layers, with the reasons that produced it …
	isolation_runtime "$ISOLATION_RUNTIME"
	isolation_class "$ISOLATION_CLASS"
	isolation_confidence "$ISOLATION_CONFIDENCE"
	isolation_why "$ISOLATION_WHY"
	machine_vmm "$MACHINE_VMM"
	machine_confidence "$MACHINE_CONFIDENCE"

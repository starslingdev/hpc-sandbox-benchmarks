#!/usr/bin/env bash
#MISE description="Sustained download speed against GitHub (curl probe)"
# Tolerant probe: no -e — report whatever the sandbox exposes (error-mode conventions:
# lib/bench.sh). The endpoint is GitHub deliberately: it is the one host every suite already depends
# on (the harness clones this repo from it), so reachability is a given and the number reflects the
# path real CI traffic takes.
#
# The probe runs curl ONCE, writing the native `%{json}` write-out as the structured result and
# rendering the human-readable log line from that JSON — a second curl for display would double the
# ~10MB transfer (and the two could disagree on a flaky path, which is exactly when this probe matters).
#
# Sustained throughput is ALL this measures. Connection setup used to be a second curl against
# github.com here; benchmark:network:latency now probes that host with three fresh connections and a
# full DNS/TCP/TLS/server decomposition, which is strictly more than the old block reported. It also
# ran under -L, which that probe documents as disqualifying for a timing measurement: following a
# redirect restarts curl's timers on a second connection and reports only the last one. -L stays
# here because the release archive legitimately redirects to a CDN and the transfer IS the
# measurement, wherever it is served from.
set -uo pipefail
REPO_ROOT="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
source "${REPO_ROOT}/lib/bench.sh"

# Render selected write-out fields from a curl %{json} result file, tolerating a missing jq (the
# toolchain image ships it; elsewhere the raw JSON line is still meaningful provenance).
summarize() {
	local file="$1" template="$2"
	if [ ! -s "$file" ]; then
		echo "(probe produced no result)"
	elif command -v jq &>/dev/null; then
		jq -r "$template" "$file" 2>/dev/null || cat "$file"
	else
		cat "$file"
	fi
}

# The probe IS curl — without it there is nothing to measure, so record the skip marker the
# normalizer expects (skip_result in lib/bench.sh) rather than exiting silently.
if ! command -v curl &>/dev/null; then
	skip_result "curl not installed" "$(task_result_name "speed")"
	exit 0
fi

echo "=== Download Speed Test ==="
echo "Downloading ~10MB test archive from GitHub..."

SPEED_JSON="$(results_dir)/$(task_result_name "speed").json"
# -sS, and stderr NOT discarded: the %{json} write-out goes to stdout (piped into json_result), so
# curl's diagnostic on stderr can't corrupt the result — and it is the whole story when the probe
# fails (DNS vs TLS vs proxy refusal), which is precisely what a network probe exists to record.
curl -sSL --max-time 120 -o /dev/null -w '%{json}' \
	"https://github.com/anthropics/anthropic-sdk-python/archive/refs/heads/main.zip" |
	json_result "$(task_result_name "speed")"
# Both halves of the pipeline are reported, because they answer different questions. curl emits its
# write-out record even when the transfer fails, so a non-zero curl with a written record is a
# RECORDED failure — the artifact carries the exit code and error message. Only json_result's own
# failure means no artifact exists at all. Captured in one statement: any command in between, an
# assignment included, would reset PIPESTATUS before the second read.
probe_status=("${PIPESTATUS[@]}")
[ "${probe_status[0]}" -ne 0 ] && echo "(download probe failed — curl exited ${probe_status[0]})"
[ "${probe_status[1]}" -ne 0 ] && echo "(no structured record written)"
summarize "$SPEED_JSON" \
	'"HTTP \(.http_code) | \(.size_download) bytes | \(.time_total)s total | \(.speed_download) bytes/sec"'

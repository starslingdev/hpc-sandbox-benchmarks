# mastra-ai/mastra (ENG-137) -- consumed by lib/pts/realworld/realworld-runner.sh. One TASK_CMD_<value> per
# <Option>/<Menu>/<Entry>/<Value> in test-definition.xml (packages/schema/src/pts-profiles.test.ts
# asserts the two stay in lockstep). git_clone has no shell command: the runner measures it via a
# fixed git-fetch algorithm, not a package script. Scoped to packages/core per ENG-137 (build:core /
# test:core), not the full monorepo build/test.
REPO_URL="https://github.com/mastra-ai/mastra.git"
PIN_SHA="b6eeb9d08ebeaf27bc6fd16b6b88087040aaf767"
NODE_VERSION="22"

TASK_CMD_git_clone=""
TASK_CMD_cold_install="pnpm install --frozen-lockfile"
TASK_CMD_lint_format="pnpm lint:format"
TASK_CMD_build_core="pnpm build:core"
# test:core is plain `pnpm --filter ./packages/core test` upstream -- no turbo graph, so it needs
# core's workspace deps' dist/. Upstream CI builds before unit tests; the Task menu measures
# build_core first, and this prep (upstream's own build:core) then replays it from the preserved
# turbo cache (see realworld-runner.sh's prep reset), leaving the timed command exactly the
# vitest run.
TASK_PREP_test_core="pnpm build:core"
# Invoke the pinned Vitest 4 runner directly so worker flags reach it without the upstream
# test:core -> pnpm test -> npm run test:unit chain. Vitest 4 removed poolOptions.
# Pass test:unit's literal exclusion argument unchanged; the pinned project config still owns
# discovery. Use one isolated fork worker under the original heap budget. HOME is canonicalized
# by the shared runner before this command starts.
# models-dev.e2e.test.ts asserts on live models.dev catalog data fetched at run time; when the
# catalog changed (2026-11-14: "Provider perplexity has no models"), every provider failed
# test_core on the same pinned commit. A benchmark must not depend on a third party's live data,
# so that one file is excluded; it is a sub-second network test.
# local-sandbox.test.ts's "bwrap isolation (Linux)" tests run only where a bwrap binary exists.
# Most images lack one and skip them; boat's stock Ubuntu ships one its non-root user cannot
# create namespaces with, so boat alone ran (and failed) 3 extra tests. Deselecting them by name
# (vitest has no negative -t, hence the lookahead) gives every provider the same test set.
TASK_CMD_test_core="NODE_OPTIONS=--max-old-space-size=4096 VITEST_MAX_WORKERS=1 pnpm --filter ./packages/core exec vitest run --exclude '**/tool-builder/**' --exclude '**/models-dev.e2e.test.ts' -t '^(?!.*bwrap isolation)' --pool=forks --maxWorkers=1"

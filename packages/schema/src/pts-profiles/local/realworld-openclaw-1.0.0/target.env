# Pinned OpenClaw developer workloads, consumed by the shared realworld runner.
# The experiment's source SHA versions this execution contract independently of upstream's pin.
REPO_URL="https://github.com/openclaw/openclaw.git"
PIN_SHA="623534400684eca7c451cf587189fae714f2abe2"
NODE_VERSION="22.19"

TASK_CMD_git_clone=""
# Upstream setup-node-env's exact cold install invocation. The runner clears node_modules,
# pnpm's actual store and caches before measurement; no retry or warm-store fallback is timed.
TASK_CMD_cold_install="CI=true pnpm install --prefer-offline --ignore-scripts=false --config.engine-strict=false --config.enable-pre-post-scripts=true --config.side-effects-cache=true --frozen-lockfile"

# Preserve every file selected by upstream's core/extensions/scripts lint shards, all rules,
# type-aware checking and the shard-specific tsconfigs. A single core invocation exceeds the
# 4 vCPU / 8 GiB target; upstream --split-core repeats compiler startup across 74 shards,
# including one-file shards. The helper asks the pinned Oxlint for its exact file list
# after upstream declaration preparation, then lints sequential batches of at most 1000 files.
# Upstream local-check mode serializes preparation and applies its Go memory policy; four
# explicit lint threads keep the same CPU budget on every provider. Empty discovery is an error.
TASK_CMD_lint_oxlint="node ../openclaw-lint.mjs all"

# NEW metric identity: all extension files selected by upstream's extensions tsconfig.
# The former lint:extensions:channels script at this pin always selected an empty set and
# returned success after preparation. It cannot represent lint work. This uses the same
# bounded type-aware execution as the full lint task and refuses empty input; no checks are
# suppressed to obtain a timing. Its samples are not comparable to the retired channel metric.
TASK_CMD_lint_extensions_all="node ../openclaw-lint.mjs extensions"

# tsgo:prod checks both core and extensions. OPENCLAW_LOCAL_CHECK=0 matches check-shard's
# throughput setting and retains the already measured in-spec typecheck workload.
TASK_CMD_typecheck="OPENCLAW_LOCAL_CHECK=0 pnpm tsgo:prod"

# Keep upstream's constrained-host policy for test-tree typechecking: the unthrottled task
# exceeds the target memory, whereas the existing throttled workload uses nearly all four
# cores and fits narrowly. This is unchanged from the preceding benchmark contract.
TASK_CMD_test_types="pnpm check:test-types"

# Historical exclusions are prospective contract decisions, never edits to frozen results:
# build:ci-artifacts cannot fit this target; shrinkwrap is stale at this pin; test_unit_fast
# had no valid samples in the frozen failed run. Those tasks were already absent on main.
